# -*- coding: utf-8 -*-
# V3: engenharia preliminar. Edite PARAMETROS e execute novamente em uma pasta nova.
# Objetos BRep editaveis; parametros desta macro NAO sao vinculados ao FCStd.
import FreeCAD as App, Part, MeshPart
from FreeCAD import Vector as V
import os, json, math
ROOT=os.path.dirname(os.path.abspath(__file__))
# PARAMETROS DE PROJETO (propostos, nao medidas de hardware)
WALL=3.0
BASE=3.0
LID_Z=28.0
TOP=31.0
CLEARANCE_HOLE=3.4
PILOT=2.5
BOSS_R=4.5
source=App.openDocument(os.path.join(ROOT,'referencias','HUD_FPGA_Stealth_V2.FCStd'))
doc=App.newDocument('HUD_FPGA_Stealth_V3')
parts=[]; reserves=[]
def feat(name,shape,color,group=None,trans=0):
 o=doc.addObject('PartDesign::Feature',name); o.Label=name.replace('_',' '); o.Shape=shape
 if App.GuiUp:
  o.ViewObject.ShapeColor=color; o.ViewObject.Transparency=trans
 if group: group.addObject(o)
 return o
def move(s,z):
 s=s.copy(); s.translate(V(0,0,z)); return s
def ext(face,z,h): return move(face,z).extrude(V(0,0,h))
def cutall(s,tools):
 for t in tools: s=s.cut(t)
 return s.removeSplitter()
def union(s,tools):
 for t in tools: s=s.fuse(t)
 return s.removeSplitter()
def cyl(r,z,h,x,y): return Part.makeCylinder(r,h,V(x,y,z))
def bounds(s):
 b=s.BoundBox; return [b.XMin,b.YMin,b.ZMin,b.XMax,b.YMax,b.ZMax]
g=doc.addObject('App::DocumentObjectGroup','Pecas_V3')
gref=doc.addObject('App::DocumentObjectGroup','Referencias_NAO_FABRICAR')
gres=doc.addObject('App::DocumentObjectGroup','Reservas_ESTIMADAS_NAO_FABRICAR')
old=source.getObject('_01_Fuselagem_Compartimento').Shape
f=max([f for f in old.Faces if f.BoundBox.ZLength<1e-6 and abs(f.BoundBox.ZMin)<1e-6],key=lambda f:f.Area)
outer=Part.Face(f.OuterWire)
inner=Part.Face(f.OuterWire.makeOffset2D(-WALL,0,False,False,False).Wires[0])
# Full hollow fuselage, detachable floor, original wings integrated into shell.
shell=ext(outer,BASE,LID_Z-BASE).cut(ext(inner,BASE-1,LID_Z-BASE+2))
wings=[source.getObject('_02_Asa_Delta_'+n).Shape.copy() for n in ['Esquerda','Direita']]
shell=union(shell,wings)
# Four wall-connected screw columns, separate blind pilots from top/bottom.
fix=[(10.,-39.),(105.,-39.),(10.,148.),(105.,148.)]
for x,y in fix:
 shell=shell.fuse(cyl(BOSS_R,BASE,LID_Z-BASE,x,y))
 # connect each boss to the adjacent wall with a bridge
 yy=-44.5 if y<0 else 148.
 shell=shell.fuse(Part.makeBox(9,7,25,V(x-4.5,yy,BASE)).common(ext(outer,BASE,LID_Z-BASE)))
shell=cutall(shell,[cyl(PILOT/2,BASE-0.1,8.1,x,y) for x,y in fix]+[cyl(PILOT/2,LID_Z-8,8.1,x,y) for x,y in fix])
base=ext(outer,0,BASE)
# Four cassette bearing pads; no assumed PCB fastening pattern.
pads=[(15,15),(105,15),(15,95),(105,95)]
base=union(base,[cyl(6,BASE,9,x,y) for x,y in pads])
# Low locating stops around the known bounding envelope, 0.6 mm nominal gap.
base=union(base,[Part.makeBox(2,22,11,V(-6.819,43,BASE)),Part.makeBox(2,22,11,V(126.739,43,BASE)),Part.makeBox(24,2,11,V(49,-6.219,BASE)),Part.makeBox(24,2,11,V(49,113.439,BASE))])
base=union(base,[Part.makeBox(72,28,2,V(24.9598968,y,BASE)) for y in [-38.619,119.839]])
base=cutall(base,[cyl(CLEARANCE_HOLE/2,-.1,3.2,x,y) for x,y in fix])
lid=ext(outer,LID_Z,TOP-LID_Z)
canopy=source.getObject('_04_Cockpit_Reserva_Joystick').Shape.copy()
fcan=max([q for q in canopy.Faces if q.BoundBox.ZLength<1e-6 and abs(q.BoundBox.ZMin-31)<1e-6],key=lambda q:q.Area)
wc=fcan.OuterWire.copy(); wc.translate(V(0,0,-31))
cavity=Part.Face(wc.makeOffset2D(-2.5,0,False,False,False).Wires[0])
lid=union(lid,[canopy]+[source.getObject('_06_Deriva_'+n).Shape.copy() for n in ['Esquerda','Direita']])
lid=cutall(lid,[ext(cavity,LID_Z-.1,10.1)]+[cyl(CLEARANCE_HOLE/2,LID_Z-.1,3.2,x,y) for x,y in fix])
for n,s,c in [('01_Base_removivel',base,(.30,.38,.46)),('02_Fuselagem_oca_asas_delta',shell,(.27,.38,.50)),('03_Tampa_cockpit_duas_derivas',lid,(.43,.50,.57))]:
 o=feat(n,s,c,g); parts.append(o)
 o.addProperty('App::PropertyString','StatusEngenharia'); o.StatusEngenharia='PRELIMINAR - nao liberado para impressao'
for n in ['Esquerda','Direita']:
 # decorative detail is separately exported; adhesive attachment proposed
 o=feat('04_Aplique_'+n,source.getObject('_03_Detalhe_Azul_'+n).Shape.copy(),(.08,.50,.78),g); parts.append(o)
ref=feat('Referencia_base_STEP_V2_sem_escala',source.getObject('Part__Feature').Shape.copy(),(.1,.6,.35),gref)
ref.addProperty('App::PropertyString','Natureza'); ref.Natureza='Caixa de terceiros; NAO e a placa Nexys A7. XY e Z preservados da V2.'
# Envelope above existing cassette is only planning allowance, not measured PCB.
def reserve(n,s):
 o=feat(n,s,(.95,.65,.18),gres,65); reserves.append(o)
 o.addProperty('App::PropertyString','Evidencia'); o.Evidencia='ESTIMATIVA de layout, sem hardware identificado'
reserve('Proto_esquerda_72x28x12',Part.makeBox(72,28,12,V(24.9598968,-38.619,5)))
reserve('Proto_direita_72x28x12',Part.makeBox(72,28,12,V(24.9598968,119.839,5)))
reserve('KY023_RESERVA_24x24x20',Part.makeBox(24,24,20,V(-44,42.61,5)))
reserve('MPU6050_GY521_RESERVA_25x18x12',Part.makeBox(25,18,12,V(137,12,5)))
reserve('BMP085_RESERVA_20x18x12',Part.makeBox(20,18,12,V(137,43,5)))
reserve('HMC5883L_RESERVA_20x18x12',Part.makeBox(20,18,12,V(137,76,5)))
reserve('Buzzer_d20_h12',cyl(10,5,12,173,55))
# Nexys PCB not modeled: only existing cassette is geometrically confirmed.
# Metadata, explicit proposal values.
meta=doc.addObject('App::FeaturePython','Notas_de_projeto')
for name,value in [('ParedeProposta',WALL),('BaseProposta',BASE),('TampaProposta',TOP-LID_Z),('FuroPassanteProposto',CLEARANCE_HOLE),('FuroPilotoProposto',PILOT)]:
 meta.addProperty('App::PropertyLength',name); setattr(meta,name,value)
meta.addProperty('App::PropertyString','Aviso'); meta.Aviso='Valores informativos; regenerar pela macro para alterar. Switches, VGA, USB e alimentacao sem recortes por falta de posicoes confirmadas.'
doc.recompute()
# Validation geometry, exact assembly overlaps, layout containment.
checks={'parts':[],'collisions':[],'reserve_pair_collisions':[],'reserves':[],'source_compatibility':{},'fasteners_xy':fix,'pad_contacts_mm2':[]}
for o in parts:
 s=o.Shape
 checks['parts'].append({'name':o.Name,'valid':s.isValid(),'solids':len(s.Solids),'volume_mm3':s.Volume,'bb':bounds(s)})
for i,a in enumerate(parts):
 for b in parts[i+1:]:
  vol=a.Shape.common(b.Shape).Volume
  if vol>1e-5: checks['collisions'].append({'a':a.Name,'b':b.Name,'mm3':vol})
for o in reserves:
 checks['reserves'].append({'name':o.Name,'bb':bounds(o.Shape),'enclosure_overlap_mm3':sum(o.Shape.common(p.Shape).Volume for p in parts),'cassette_overlap_mm3':o.Shape.common(ref.Shape).Volume})
for i,a in enumerate(reserves):
 for b in reserves[i+1:]:
  v=a.Shape.common(b.Shape).Volume
  if v>1e-5: checks['reserve_pair_collisions'].append({'a':a.Name,'b':b.Name,'mm3':v})
checks['source_compatibility']['reference_symmetric_difference_mm3']=ref.Shape.cut(source.getObject('Part__Feature').Shape).Volume+source.getObject('Part__Feature').Shape.cut(ref.Shape).Volume
checks['source_compatibility']['cassette_enclosure_overlap_mm3']=sum(ref.Shape.common(p.Shape).Volume for p in parts)
for x,y in pads:
 disk=Part.Face(Part.Wire(Part.makeCircle(6,V(x,y,12))))
 checks['pad_contacts_mm2'].append(disk.common(ref.Shape).Area)
json.dump(checks,open(os.path.join(ROOT,'verificacao_V3.json'),'w'),indent=2)
# STEP/STL are intentionally preliminary; assembly STEP excludes estimated hardware.
exp=os.path.join(ROOT,'exportacoes_PRELIMINARES'); os.makedirs(exp,exist_ok=True)
for o in parts:
 o.Shape.exportStep(os.path.join(exp,o.Name+'.step'))
 mesh=MeshPart.meshFromShape(Shape=o.Shape,LinearDeflection=.12,AngularDeflection=.25,Relative=False)
 mesh.write(os.path.join(exp,o.Name+'.stl'))
 checks['parts'][parts.index(o)]['mesh_closed']=mesh.isSolid()
Part.makeCompound([o.Shape for o in parts]).exportStep(os.path.join(exp,'Montagem_V3_SEM_ELETRONICA.step'))
json.dump(checks,open(os.path.join(ROOT,'verificacao_V3.json'),'w'),indent=2)
if App.GuiUp:
 for o in reserves: o.Visibility=False
 ref.Visibility=False
 Gui.activeDocument().activeView().viewAxonometric(); Gui.activeDocument().activeView().fitAll()
doc.recompute(); doc.saveAs(os.path.join(ROOT,'HUD_FPGA_Stealth_V3.FCStd'))
App.closeDocument(source.Name)
print(json.dumps(checks,indent=2))
